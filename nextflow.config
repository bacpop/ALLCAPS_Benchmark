/*
 * Pneumococcal Serotyping Benchmark Pipeline
 *
 * Compare multiple in-silico serotyping tools against a common test set.
 */

params {
    // ── Inputs ────────────────────────────────────────────────
    input           = null   // Samplesheet CSV: sample_id,fasta,fastq_1,fastq_2
    labels          = null   // Ground-truth CSV: Public_ID,Contig_ID,Serotype,Is_capsule
    multifasta      = null   // Optional: multi-FASTA to split (instead of per-sample fasta in samplesheet)

    // ── AllCaps-specific ─────────────────────────────────────
    allcaps_model   = null   // Path to .pth model checkpoint
    allcaps_repo    = null   // Path to pneumococcal-serotyping repo root

    // ── Tool selection (skip all by default) ───────────────────
    run_seroba      = false
    run_pneumokity  = false
    run_pfaster     = false
    run_allcaps     = false
    run_pneumocat   = false  // placeholder – not yet implemented
    run_serocall    = false  // placeholder – not yet implemented
    run_pneumotyper = false  // placeholder – not yet implemented

    // ── Precomputed results ──────────────────────────────────
    precomputed     = null   // Directory of per-tool CSVs from previous runs

    // ── Output ───────────────────────────────────────────────
    outdir          = 'results'

    // ── Resources defaults ───────────────────────────────────
    max_cpus        = 4
    max_memory      = '16.GB'
    max_time        = '4.h'
}

// ── Profiles ──────────────────────────────────────────────────
profiles {
    standard {
        process.executor = 'local'
    }

    slurm {
        includeConfig 'conf/slurm.config'
    }
}

// ── Singularity ───────────────────────────────────────────────
singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "${projectDir}/singularity-cache"
}

// ── Process defaults ──────────────────────────────────────────
process {
    cpus   = 1
    memory = '4.GB'
    time   = '1.h'

    errorStrategy = 'retry'
    maxRetries    = 1

    withLabel: 'process_low' {
        cpus   = 1
        memory = '16.GB'
        time   = '4.h'
    }

    withLabel: 'process_high' {
        cpus   = 1
        memory = '48.GB'
        time   = '24.h'
    }

    withLabel: 'process_batch' {
        cpus   = 1
        memory = '200.GB'
        time   = '72.h'
    }
}

// ── Reports ───────────────────────────────────────────────────
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/timeline.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/trace.txt"
    overwrite = true
}

manifest {
    name            = 'serotype-benchmark'
    author          = 'Alireza'
    description     = 'Benchmark pneumococcal serotyping tools'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04'
    version         = '0.1.0'
}
