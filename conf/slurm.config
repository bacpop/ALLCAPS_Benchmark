/*
 * SLURM executor configuration
 *
 * Adjust queue, account, and cacheDir to match your cluster.
 */

process {
    executor = 'slurm'

    // Uncomment and set your partition / account:
    // queue   = 'standard'
    // clusterOptions = '--account=your_account'
}

executor {
    name            = 'slurm'
    queueSize       = 200
    submitRateLimit = '10/1sec'
}

singularity {
    enabled    = true
    autoMounts = true
    // Set this to a shared filesystem path visible to all nodes:
    cacheDir   = "${projectDir}/singularity-cache"
}
