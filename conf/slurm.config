/*
 * SLURM executor configuration
 *
 * Adjust queue, account, and cacheDir to match your cluster.
 */

process {
    executor = 'slurm'
    // Cluster-specific options for the SLURM executor, such as queue and account:
    // queue   = 'standard'
    // clusterOptions = '--account=your_account'
}

executor {
    name            = 'slurm'
    queueSize       = 200
    submitRateLimit = '10/1sec'
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "${System.getenv('SINGULARITY_CACHEDIR') ?: '${projectDir}/singularity'}"
}
